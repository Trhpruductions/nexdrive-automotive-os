# ── NexDrive Automotive OS — environment ──
# Copy to .env and fill in. Never commit .env.

# Public URL of this installation (used in customer approval links / notifications)
APP_URL="https://app.yourdomain.com"
# Domain Caddy should obtain an HTTPS certificate for (docker compose only)
DOMAIN="app.yourdomain.com"
# Server time zone — appointment times, "today", reminders and the daily digest use it
TZ="America/New_York"

# Database (docker compose builds DATABASE_URL from POSTGRES_PASSWORD; set DATABASE_URL directly when running without compose)
POSTGRES_PASSWORD="change-me-long-random"
# DATABASE_URL="postgresql://nexdrive:password@127.0.0.1:5432/nexdrive?schema=public"

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-32-plus-random-characters"

# Ops alerts: scheduler failures and unhandled request errors are POSTed here (Slack / Discord webhook URL)
OPS_WEBHOOK_URL=""

# Optional providers
ANTHROPIC_API_KEY=""          # NexDrive AI (Claude)

# NexDrive's OWN Stripe account for shop subscriptions (self-service /billing). Leave blank to manage plans by hand in /admin.
STRIPE_PLATFORM_SECRET_KEY=""
STRIPE_PLATFORM_WEBHOOK_SECRET=""   # endpoint: /api/stripe/platform (checkout.session.completed, invoice.paid, invoice.payment_failed, customer.subscription.updated/deleted)
STRIPE_PRICE_STARTER=""             # price_… ids from the Stripe dashboard
STRIPE_PRICE_PRO=""
RESEND_API_KEY=""             # email notifications + password reset links (Resend)
# ...or plain SMTP instead of Resend
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="0"               # 1 for implicit TLS (port 465)
EMAIL_FROM="NexDrive <no-reply@yourdomain.com>"
TWILIO_ACCOUNT_SID=""         # SMS notifications
TWILIO_AUTH_TOKEN=""
TWILIO_FROM="+15555550100"
# Two-way SMS: point the Twilio number's "A message comes in" webhook at  $APP_URL/api/twilio/inbound
